{
  "name": "dogu",
  "private": true,
  "version": "0.2.5-beta.3",
  "description": "A practical desktop file workbench for local files, remotes and queued operations.",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/Otakora/dogu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Otakora/dogu.git"
  },
  "bugs": {
    "url": "https://github.com/Otakora/dogu/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "check": "node ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "tauri:dev": "node ./scripts/tauri-dev.mjs",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "updater:generate-dev-key": "node ./scripts/generate-updater-dev-key.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
