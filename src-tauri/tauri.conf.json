{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dogu",
  "version": "0.2.1",
  "identifier": "io.github.otakora.dogu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dogu",
        "width": 1520,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "../third_party/**/*",
      "../THIRD_PARTY_NOTICES",
      "../packaging/assets/io.github.otakora.dogu.svg"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}
